<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maui="clr-namespace:Avalonia.Maui.Controls;assembly=Avalonia.Maui"
             xmlns:ava="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             x:Class="MauiAvaloniaApplication.MainPage">

    <VerticalStackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Center">
        <maui:AvaloniaView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <ava:TextBox Text="Maui Avalonia TextBox" HorizontalAlignment="Stretch"/>
        </maui:AvaloniaView>
        <Entry Text="Maui Entry"/>
    </VerticalStackLayout>

</ContentPage>
